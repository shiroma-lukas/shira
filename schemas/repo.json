{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "apiVersion": {
      "type": "string",
      "const": "atp/v1"
    },
    "kind": {
      "type": "string",
      "const": "Repo"
    },
    "repo": {
      "type": "string",
      "pattern": "^[\\w.-]+\\/[\\w.-]+$"
    },
    "defaultBranch": {
      "default": "main",
      "type": "string",
      "minLength": 1
    },
    "image": {
      "type": "string",
      "minLength": 1
    },
    "setup": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "test": {
      "type": "string",
      "minLength": 1
    },
    "lint": {
      "type": "string",
      "minLength": 1
    },
    "flaky": {
      "default": {
        "quarantine": [],
        "retries": 0
      },
      "type": "object",
      "properties": {
        "quarantine": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "retries": {
          "default": 0,
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        }
      }
    },
    "egress": {
      "default": {
        "allow": []
      },
      "type": "object",
      "properties": {
        "allow": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "limits": {
      "default": {
        "minutes": 60,
        "cpus": 2,
        "memoryMb": 4096
      },
      "type": "object",
      "properties": {
        "minutes": {
          "default": 60,
          "type": "number",
          "exclusiveMinimum": 0
        },
        "cpus": {
          "default": 2,
          "type": "number",
          "exclusiveMinimum": 0
        },
        "memoryMb": {
          "default": 4096,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      }
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "repo",
    "image",
    "test"
  ]
}
