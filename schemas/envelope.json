{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "v": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "task_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "from": {
      "type": "string",
      "enum": [
        "concierge",
        "orchestrator",
        "architect",
        "planner",
        "worker",
        "reviewer",
        "librarian"
      ]
    },
    "to": {
      "type": "string",
      "enum": [
        "concierge",
        "orchestrator",
        "architect",
        "planner",
        "worker",
        "reviewer",
        "librarian"
      ]
    },
    "goal": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "refs": {
      "maxItems": 50,
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "file"
              },
              "repo": {
                "type": "string",
                "pattern": "^[\\w.-]+\\/[\\w.-]+$"
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha": {
                "type": "string",
                "pattern": "^[0-9a-f]{7,40}$"
              }
            },
            "required": [
              "kind",
              "repo",
              "path"
            ]
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "context"
              },
              "path": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "kind",
              "path"
            ]
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "decision"
              },
              "id": {
                "type": "string",
                "pattern": "^D-\\d{4,}$"
              }
            },
            "required": [
              "kind",
              "id"
            ]
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "task"
              },
              "id": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              }
            },
            "required": [
              "kind",
              "id"
            ]
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "run"
              },
              "id": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              }
            },
            "required": [
              "kind",
              "id"
            ]
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "pr"
              },
              "repo": {
                "type": "string",
                "pattern": "^[\\w.-]+\\/[\\w.-]+$"
              },
              "number": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "kind",
              "repo",
              "number"
            ]
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "thread"
              },
              "provider": {
                "type": "string",
                "enum": [
                  "slack",
                  "github",
                  "cli"
                ]
              },
              "id": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "kind",
              "provider",
              "id"
            ]
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "transcript"
              },
              "uri": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "kind",
              "uri"
            ]
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "url"
              },
              "url": {
                "type": "string",
                "format": "uri"
              }
            },
            "required": [
              "kind",
              "url"
            ]
          }
        ]
      }
    },
    "scope": {
      "type": "object",
      "properties": {
        "repo": {
          "type": "string",
          "pattern": "^[\\w.-]+\\/[\\w.-]+$"
        },
        "paths": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "repo",
        "paths"
      ]
    },
    "done_when": {
      "minItems": 1,
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "budget": {
      "type": "object",
      "properties": {
        "usd": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "tokens": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "minutes": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "retries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        }
      },
      "required": [
        "usd",
        "tokens",
        "minutes",
        "retries"
      ]
    }
  },
  "required": [
    "v",
    "id",
    "task_id",
    "from",
    "to",
    "goal",
    "refs",
    "scope",
    "done_when",
    "budget"
  ]
}
