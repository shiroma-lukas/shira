{
  "name": "shira",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Control plane for a managed team of AI coding agents (see docs/prd.md)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "validate-config": "tsx src/config/validate.ts config",
    "schemas": "tsx scripts/export-schemas.ts",
    "shira": "tsx src/cli/shira.ts",
    "build:egress": "esbuild src/egress/main.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/egress-proxy.mjs"
  },
  "dependencies": {
    "pg": "^8.23.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.16",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.25.12",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7"
  },
  "packageManager": "pnpm@10.24.0",
  "license": "Apache-2.0"
}
