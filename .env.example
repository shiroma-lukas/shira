# Copy to .env and adjust. Variables already set in the environment win over this file.
# Docker Compose reads .env too (SHIRA_EGRESS_ADMIN_TOKEN).

# CLI database (default: the compose Postgres on port 54329). Outside development, use the
# least-privilege user from `shira app-user` here and the admin user below.
DATABASE_URL=postgres://shira:shira@localhost:54329/shira
# Admin connection for `migrate` and `app-user` (default: DATABASE_URL)
# SHIRA_ADMIN_DATABASE_URL=postgres://shira:shira@localhost:54329/shira

# Throwaway database for the concurrent-claim test; its schema is dropped on every run
# SHIRA_TEST_DATABASE_URL=postgres://shira:shira@localhost:54329/shira_test

# Shared secret for the egress proxy admin API (openssl rand -hex 24)
# SHIRA_EGRESS_ADMIN_TOKEN=

# dispatch
# Model provider keys: only the ones your agents use (docs/providers.md)
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
# SHIRA_GITHUB_APP_ID=
# SHIRA_GITHUB_PRIVATE_KEY_PATH=
